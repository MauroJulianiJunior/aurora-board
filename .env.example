# Aurora Board — configuração opcional.
#
# O app NÃO usa nenhuma chave, token, senha ou serviço externo: tudo roda no navegador e
# os quadros ficam no IndexedDB da sua máquina. Este arquivo existe só para ajustar portas.
# Copie para .env se quiser mudar algum valor (o .env não vai para o git).

# Porta do servidor de desenvolvimento (npm run dev). Padrão: 5173.
AURORA_BOARD_PORT=5173

# Porta do "npm run preview" (vite preview). Padrão: 4173.
AURORA_BOARD_PREVIEW_PORT=4173

# Endereço e porta do servidor de produção local (npm start / npm run serve). Padrão: 127.0.0.1:4180.
# Deixe em 127.0.0.1: assim a lousa não fica visível para outras máquinas da rede.
AURORA_BOARD_SERVE_HOST=127.0.0.1
AURORA_BOARD_SERVE_PORT=4180
